# Copy this file to .env to change a setting. Every line is optional.

# Where the work is stored. The default is a SQLite file in backend/data.
# A Postgres URL, such as a Supabase one, works too: postgresql+asyncpg://user:password@host/database
# SMOOTH_DIAGRAMS_DATABASE_URL=sqlite+aiosqlite:///C:/path/to/smooth_diagrams.db

# Pattern of the origins that may call this server. The default allows this computer on any port.
# SMOOTH_DIAGRAMS_FRONTEND_ORIGIN_PATTERN=http://localhost:\d+

# Id of the model selected when the app opens; the ids are listed in smooth_diagrams/model_catalog.py.
# SMOOTH_DIAGRAMS_DEFAULT_MODEL=claude-opus-5-5

# Folder that holds uploaded images. The default is backend/data/assets.
# SMOOTH_DIAGRAMS_ASSETS_DIRECTORY=C:/path/to/assets

# Id of the model that offers taste reasons.
# SMOOTH_DIAGRAMS_TASTE_REASON_MODEL=claude-sonnet-5-5

# The image model that sorts the library by similarity, downloaded from Hugging Face on first
# use. The default is the quantized CLIP image model (89 MB); vision_model.onnx in the same
# repository is the full one (352 MB).
# SMOOTH_DIAGRAMS_SIMILARITY_MODEL_FILE=onnx/vision_model.onnx

# GPT runs through the Codex program on this machine's ChatGPT plan login (`codex login`).
# SMOOTH_DIAGRAMS_CODEX_PROGRAM=C:/path/to/codex.cmd

# How long GPT thinks before each answer: low, medium, or high.
# SMOOTH_DIAGRAMS_GPT_REASONING_EFFORT=medium

# Claude runs on this machine's Claude plan login. Do not set ANTHROPIC_API_KEY here or in
# the environment unless you want model calls billed to the API instead of the plan.
# The same goes for OPENAI_API_KEY and GPT.
